{
	"name": "new",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "vite preview",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"deploy": "pnpm run build && wrangler deploy",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply --local og-data",
		"db:migrate:remote": "wrangler d1 migrations apply og-data",
		"prepare": "husky"
	},
	"devDependencies": {
		"@a01sa01to/ui": "3.0.0-alpha.2",
		"@biomejs/biome": "^2.5.15",
		"@cloudflare/vite-plugin": "^1.26.0",
		"@file-type/xml": "^1.2.0",
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/react-devtools": "^0.10.13",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-query-devtools": "^5.104.1",
		"@tanstack/react-router": "^1.170.41",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "^1.168.60",
		"@tanstack/router-cli": "^1.167.40",
		"@types/node": "^26.6.4",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"cheerio": "^1.2.0",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.9",
		"drizzle-orm": "^0.45.1",
		"file-type": "^22.1.1",
		"husky": "^9.1.7",
		"image-size": "^2.0.4",
		"lint-staged": "^17.6.0",
		"lucide-react": "^1.52.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-tweet": "^3.3.1",
		"typescript": "^7.0.2",
		"valibot": "^1.5.0",
		"vite": "^8.0.0",
		"wasm-image-optimization": "^2.0.11",
		"wrangler": "^4.70.0"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	}
